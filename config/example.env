# Wombot configuration example
# Copy this to a local configuration file when needed.

# Backend
WOMBOT_HOST=0.0.0.0
WOMBOT_PORT=8000

# Serial communication
WOMBOT_SERIAL_PORT=/dev/ttyUSB0
WOMBOT_SERIAL_BAUD=115200

# Camera / MediaMTX
WOMBOT_CAMERA_ENABLED=true
WOMBOT_MEDIAMTX_PORT=8889

# Wombot access point
WOMBOT_AP_SSID=Wombot
WOMBOT_AP_IP=10.42.0.1